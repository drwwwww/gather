{
  "name": "mobile",
  "private": true,
  "main": "index.js",
  "scripts": {
    "prestart": "node ./scripts/ensure-hoisted-module-links.js",
    "start": "cross-env EXPO_NO_CACHE=1 expo start",
    "start:clear": "node ./scripts/ensure-hoisted-module-links.js && cross-env EXPO_NO_CACHE=1 expo start --clear",
    "android": "cross-env EXPO_NO_CACHE=1 expo start --android",
    "ios": "cross-env EXPO_NO_CACHE=1 expo start --ios",
    "web": "cross-env EXPO_NO_CACHE=1 expo start --web",
    "typecheck": "tsc --noEmit",
    "postinstall": "node ./scripts/ensure-hoisted-module-links.js"
  },
  "dependencies": {
    "@expo-google-fonts/rubik": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@gather/lib": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.14.10",
    "@react-navigation/elements": "2.9.14",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@sentry/react-native": "^7.11.0",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "^57.0.20",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "^57.0.1",
    "expo-location": "~57.0.16",
    "expo-modules-core": "57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.10",
    "cross-env": "^10.1.0",
    "typescript": "^6.0.3"
  }
}
