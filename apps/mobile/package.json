{
  "name": "mobile",
  "private": true,
  "main": "index.js",
  "scripts": {
    "prestart": "node ./scripts/ensure-hoisted-module-links.js",
    "start": "cross-env EXPO_NO_CACHE=1 expo start",
    "start:clear": "node ./scripts/ensure-hoisted-module-links.js && cross-env EXPO_NO_CACHE=1 expo start --clear",
    "android": "cross-env EXPO_NO_CACHE=1 expo start --android",
    "ios": "cross-env EXPO_NO_CACHE=1 expo start --ios",
    "web": "cross-env EXPO_NO_CACHE=1 expo start --web",
    "typecheck": "tsc --noEmit",
    "postinstall": "node ./scripts/ensure-hoisted-module-links.js"
  },
  "dependencies": {
    "@expo-google-fonts/rubik": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gather/lib": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.14.10",
    "@react-navigation/elements": "2.9.14",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@sentry/react-native": "^8.23.0",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "^54.0.0",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "^55.0.13",
    "expo-modules-core": "3.0.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.5.4"
  }
}
