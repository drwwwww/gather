node-linker=hoisted
# Windows: avoid hardlink + temp _tmp_* races (ENOENT on scandir during install)
package-import-method=copy
# Keep React Navigation packages at workspace root to reduce nested layout churn
public-hoist-pattern[]=*react-navigation*
# Non-interactive installs when pnpm must rebuild node_modules (pnpm camelCase key)
confirmModulesPurge=false
