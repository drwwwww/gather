{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gather-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 3000
    },
    {
      "name": "gather-mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "mobile", "exec", "expo", "start", "--web", "--port", "8082"],
      "port": 8082
    }
  ]
}
